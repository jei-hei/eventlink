# Local env: use EITHER app/.env OR app/.env.local (Vite loads both).
# Do not commit real keys.

# --- Required for the Vue app (Vercel uses the same VITE_* names) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Only for scripts/create-admin.mjs (never put service role on Vercel) ---
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ADMIN_EMAIL=admin@eventlink.local
# ADMIN_PASSWORD=EventLinkAdmin123!
